rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow user profile sync and learning progress
    match /users/{userId} {
      allow read, write: if true;
    }

    // Allow admin whitelist records
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Allow audit trail logs of progress resets
    match /audit_resets/{logId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
